+function approvalOwner() {
+    const scope = local.getStore();
+    if (!scope?.workId) return null;
+    const { workId, signal, fence } = scope;
+    return { workId, isCurrent() {
+        if (signal.aborted) return false;
+        try { fence(); return true; }
+        catch { return false; }
+    } };
